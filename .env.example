# Application
APP_NAME=barekat-diagnostics
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Auth / Security
AUTH_ENABLED=false
SECRET_KEY=dev-secret-change-me-barekat-diagnostics
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUDIT_RETENTION_YEARS=7

# Lab batch controls
REQUIRE_BATCH_CONTROLS=true
DEFAULT_POS_CONTROL_CT_MAX=32.0
DEFAULT_NEG_CONTROL_CT_MIN=38.0

# Pilot validation
PILOT_DATA_PATH=data/pilot/pilot_qpcr.csv

# Database
DATABASE_URL=postgresql://barekat:barekat@localhost:5432/barekat_diagnostics

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (raw sensor curves, calibration files)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=barekat
S3_SECRET_KEY=barekatsecret
S3_BUCKET=barekat-diagnostics
S3_REGION=us-east-1

# Pipeline
PIPELINE_MODE=simulated
PIPELINE_WORK_DIR=/data/processed

# Quality Control
QC_MIN_QUALITY_SCORE=0.5
QC_MIN_SIGNAL_TO_NOISE=1.2
QC_MIN_AMPLIFICATION_EFFICIENCY=0.8

# ML Models
MODEL_PATH=data/models
CLASSIFIER_MODEL=diagnostic_classifier_v1.pkl
CLASSIFIER_TYPE=random_forest
ML_AB_TEST_ENABLED=false
ML_AB_TEST_CHALLENGER=v2
ML_AB_TEST_TRAFFIC_PCT=0.1
ML_ROLLBACK_THRESHOLD=0.05

# Drift / signal quality
DRIFT_PSI_THRESHOLD=2.0
DRIFT_POSITIVE_RATE_THRESHOLD=0.15
SIGNAL_QUALITY_DROP_THRESHOLD=0.15

# Edge / Offline
INFERENCE_BACKEND=onnx
ONNX_MODEL_PATH=data/models/diagnostic_classifier_v1.onnx
OFFLINE_SQLITE_PATH=data/offline/local.db
OFFLINE_SYNC_API_URL=http://localhost:8000/api/v1
EDGE_DEVICE_ID=DEV-001
EDGE_CENTER_ID=CTR-TEH-01
EDGE_TENANT_ID=TENANT-A
EDGE_SYNC_TOKEN=
EDGE_SYNC_MAX_RETRIES=3
EDGE_SYNC_BACKOFF_SECONDS=1.0
EDGE_CONFLICT_POLICY=reject_duplicate
EDGE_BUNDLE_DIR=data/edge_bundles
EDGE_BUNDLE_SECRET=edge-bundle-dev-secret
EDGE_REQUIRE_LOCKED_MODEL=false
EDGE_LATENCY_SLA_MS=100
EDGE_ENFORCE_LATENCY_SLA=false
EDGE_WARMUP_ITERATIONS=3
EDGE_ORT_INTRA_OP_THREADS=1
EDGE_ORT_INTER_OP_THREADS=1

# Observability
METRICS_ENABLED=true
LOG_JSON=false
LOG_LEVEL=INFO
