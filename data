import numpy as np
import pandas as pd
from scipy.special import expit

def generate_diagnostic_kit_data(n_samples=1000, n_features=12):
    """
    تولید داده‌های سنتتیک برای کیت‌های تشخیصی (qPCR, ELISA, و غیره)
    
    پارامترها:
    n_samples: تعداد نمونه‌ها
    n_features: تعداد ویژگی‌های اندازه‌گیری‌شده
    
    بازگشت: دیتافریم با داده‌های سیگنال و وضعیت تشخیص
    """
    np.random.seed(42)
    
    # 1. تولید وضعیت واقعی (Ground Truth) - 70% منفی، 30% مثبت
    true_status = np.random.choice([0, 1], n_samples, p=[0.70, 0.30])
    
    # 2. شبیه‌سازی سیگنال‌های خام برای هر نمونه
    feature_data = {}
    for i in range(n_features):
        # سیگنال پایه (نویز پس‌زمینه)
        base_signal = np.random.normal(0.5, 0.15, n_samples)
        base_signal = np.clip(base_signal, 0, 1.5)
        
        # اضافه کردن سیگنال برای نمونه‌های مثبت (بهبود سیگنال)
        positive_boost = np.random.normal(0.3, 0.1, n_samples) * true_status
        feature_data[f'Feature_{i+1}'] = base_signal + positive_boost
        
        # افزودن نویز در برخی ویژگی‌ها
        if i > 5:
            noise = np.random.normal(0, 0.05, n_samples) * np.random.choice([0, 1], n_samples, p=[0.70, 0.30])
            feature_data[f'Feature_{i+1}'] += noise
    
    # 3. شبیه‌سازی Ct Value برای qPCR (اگر کیت qPCR باشد)
    ct_values = np.zeros(n_samples)
    for i in range(n_samples):
        if true_status[i] == 1:  # مثبت - Ct پایین‌تر
            ct_values[i] = np.random.normal(18, 3)
        else:  # منفی - Ct بالاتر یا Undetermined
            ct_values[i] = np.random.normal(35, 5)
    ct_values = np.clip(ct_values, 12, 45)
    
    # 4. شبیه‌سازی منحنی رشد (Sigmoid Curve)
    def sigmoid_curve(cycle, ec50, hill=1.5, max_amp=2):
        """شبیه‌سازی منحنی رشد qPCR"""
        return max_amp / (1 + np.exp(-hill * (cycle - ec50)))
    
    # تولید داده‌های منحنی برای 40 سیکل
    curve_data = {}
    for i in range(n_samples):
        cycle = np.arange(1, 41)
        if true_status[i] == 1:
            ec50 = np.random.normal(20, 3)
        else:
            ec50 = np.random.normal(32, 5)
        curve_data[f'Curve_{i}'] = sigmoid_curve(cycle, ec50) + np.random.normal(0, 0.02, 40)
    
    # 5. افزودن خطاهای سیستماتیک
    # خطای کالیبراسیون در برخی نمونه‌ها
    calibration_error = np.random.choice([0, 1], n_samples, p=[0.90, 0.10])
    for i in range(n_samples):
        if calibration_error[i] == 1:
            for j in range(n_features):
                feature_data[f'Feature_{j+1}'][i] *= np.random.uniform(0.8, 1.2)
    
    # 6. ساخت دیتافریم نهایی
    df = pd.DataFrame({
        'Sample_ID': [f'S{str(i).zfill(4)}' for i in range(n_samples)],
        'True_Status': true_status,
        'Ct_Value': np.round(ct_values, 2),
        'Calibration_Error': calibration_error
    })
    
    # اضافه کردن ویژگی‌ها
    for feat_name, feat_values in feature_data.items():
        df[feat_name] = np.round(feat_values, 4)
    
    # 7. اضافه کردن پارامترهای کنترل کیفیت
    df['Signal_to_Noise'] = np.random.uniform(1.5, 4.0, n_samples)
    df['Amplification_Efficiency'] = np.random.uniform(0.85, 1.05, n_samples)
    df['Quality_Score'] = np.random.uniform(0.6, 0.99, n_samples)
    
    # 8. اعمال محدودیت‌ها: برخی نمونه‌ها غیرقابل اعتماد هستند
    unreliable_idx = np.random.choice(n_samples, size=int(n_samples*0.05), replace=False)
    df.loc[unreliable_idx, 'Quality_Score'] = np.random.uniform(0.2, 0.5, len(unreliable_idx))
    
    return df

# تولید داده
diagnostic_data = generate_diagnostic_kit_data(n_samples=800)

print(f"تعداد نمونه‌ها: {len(diagnostic_data)}")
print(f"\nتوزیع وضعیت واقعی:")
print(diagnostic_data['True_Status'].value_counts())
print(f"\nمیانگین Ct Value: {diagnostic_data['Ct_Value'].mean():.2f}")
print(f"\nنمونه داده:")
print(diagnostic_data.head())
